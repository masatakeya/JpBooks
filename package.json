{
  "name": "jpbooks",
  "version": "2.0.0",
  "description": "Obsidian plugin: 日本語書籍検索（NDLサーチ + openBD）と読書ノート生成",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "ndl",
    "openbd",
    "book"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.3"
  }
}
